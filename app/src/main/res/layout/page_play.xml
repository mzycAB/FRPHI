<?xml version="1.0" encoding="utf-8"?>
<!-- 选曲页：默认背景色与主界面一致（#F2F4F8），长按空白处可换成自己选的背景图。
     列表 2/3、竖长方形 1/3，四周留白；右侧灰条浮在最右，不占内容区。
     每个容器都关掉 clipChildren：被选中的项目放大 10% 时不能被列表边缘切掉。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playPageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F8"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 背景图（长按这里换背景；没设置时是透明的，露出上面的 #F2F4F8） -->
    <ImageView
        android:id="@+id/playBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000"
        android:clickable="true"
        android:focusable="true"
        android:longClickable="true"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/playContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- 左 2/3：可上下滚动的谱面列表 + 右下角悬浮 START -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="10dp">

            <!-- 一次滑动只吸一个项目：SnapScrollView 吃掉 fling，按「位移过半」吸附 -->
            <com.piezmaker.SnapScrollView
                android:id="@+id/playListScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/playList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingBottom="120dp" />
            </com.piezmaker.SnapScrollView>

            <TextView
                android:id="@+id/btnPlayStart"
                android:layout_width="104dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_btn_blue"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="START"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 右 1/3：竖着的灰色长方形（9:16，尺寸在代码里按比例算） -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="4dp">

            <ImageView
                android:id="@+id/playCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="#C8CDD6"
                android:clickable="true"
                android:focusable="true"
                android:longClickable="true"
                android:scaleType="centerCrop" />
        </FrameLayout>
    </LinearLayout>

    <!-- 新界面保留右侧灰条（和主界面那个完全同款），滑动它滑回主界面 -->
    <View
        android:id="@+id/sideBarRightPlay"
        android:layout_width="10dp"
        android:layout_height="264dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="2dp"
        android:background="@drawable/bg_side_bar" />

    <View
        android:id="@+id/sideBarRightPlayTouch"
        android:layout_width="12dp"
        android:layout_height="264dp"
        android:layout_gravity="end|center_vertical"
        android:clickable="true"
        android:focusable="true" />
</FrameLayout>
