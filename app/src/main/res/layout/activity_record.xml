<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14161E">

    <com.piezmaker.RecordView
        android:id="@+id/recordView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 判定线编辑输入面板（长按判定线进入编辑时显示）：角度/坐标X/坐标Y/流速 -->
    <LinearLayout
        android:id="@+id/lineEditPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="86dp"
        android:layout_marginEnd="12dp"
        android:background="#66000000"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="角度°"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/editAngle"
                android:layout_width="64dp"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_btn_transparent"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:maxLength="7"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="坐标X"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/editLX"
                android:layout_width="56dp"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_btn_transparent"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:maxLength="6"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="坐标Y"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/editLY"
                android:layout_width="56dp"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_btn_transparent"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:maxLength="6"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="流速"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/editLineSpeed"
                android:layout_width="56dp"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_btn_transparent"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:maxLength="6"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 顶部：标题 + 阶段 + 导出（右上角） + 时间条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#99000000"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="曲名"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="缩放"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/scaleEdit"
                    android:layout_width="56dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="1dp"
                    android:background="@drawable/bg_btn_transparent"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:maxLength="7"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="倍速"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/speedEdit"
                    android:layout_width="56dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="1dp"
                    android:background="@drawable/bg_btn_transparent"
                    android:gravity="center"
                    android:hint="1.0"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:maxLength="6"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:selectAllOnFocus="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#99FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCompat"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_btn_transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="84dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="兼容关闭"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnSmooth"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_btn_transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="72dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="平滑:关"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnSound"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_btn_transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="72dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="音效:开"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnExport"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="导出 .pez"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="BPM 120 · 已放 0"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxHeight="3dp"
            android:minHeight="3dp" />

    </LinearLayout>

    <!-- 底部：四阶段 + 控制 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPass1"
                style="@style/PassButton"
                android:text="第一次" />

            <TextView
                android:id="@+id/btnPass2"
                style="@style/PassButton"
                android:text="第二次" />

            <TextView
                android:id="@+id/btnPass3"
                style="@style/PassButton"
                android:text="第三次" />

            <TextView
                android:id="@+id/btnPass4"
                style="@style/PassButton"
                android:text="第四次" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                style="@style/SmallButton"
                android:text="退出" />

            <TextView
                android:id="@+id/btnRestart"
                style="@style/SmallButton"
                android:text="AUTOPLAY" />

            <TextView
                android:id="@+id/btnUndo"
                style="@style/SmallButton"
                android:text="撤销" />

            <TextView
                android:id="@+id/btnPause"
                style="@style/SmallButton"
                android:text="暂停" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>